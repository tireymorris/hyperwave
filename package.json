{
  "name": "hyperwave",
  "version": "0.2.1",
  "scripts": {
    "build": "bun build:css && bun build --compile ./src/server.tsx",
    "build:css": "unocss \"src/**/*.tsx\" -o public/styles/uno.css",
    "css": "unocss --watch \"src/**/*.tsx\" -o public/styles/uno.css",
    "dev": "bun install && concurrently --restart-tries=3 \"bun css\" \"bun --hot src/server.tsx\""
  },
  "dependencies": {
    "@unocss/preset-web-fonts": "^66.10.0",
    "hono": "^4.13.7",
    "unocss": "^66.10.0"
  },
  "devDependencies": {
    "@unocss/cli": "^66.10.0",
    "bun-types": "^1.4.1",
    "concurrently": "^9.2.4"
  },
  "module": "src/server.tsx"
}
